{
  "name": "ripe-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "docusaurus build",
    "watch": "fuser -k 3000/tcp; concurrently \"nodemon --watch docs --watch blog --watch src --watch static --watch docusaurus.config.ts --watch sidebars.ts --ext md,mdx,ts,tsx,js,jsx,css,json --exec 'npm run build'\" \"docusaurus serve\"",
    "typecheck": "tsc",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@docusaurus/core": "3.9.2",
    "@docusaurus/preset-classic": "3.9.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.9.2",
    "@docusaurus/tsconfig": "3.9.2",
    "@docusaurus/types": "3.9.2",
    "concurrently": "^10.0.4",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "typescript": "~5.6.2"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "uuid": "^11.1.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
